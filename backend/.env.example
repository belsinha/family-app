# Copy this file to backend/.env and fill in your own values for local development.
# backend/.env is gitignored — never commit real credentials.

PORT=3001
NODE_ENV=development
# Relative paths are fine for local dev. REQUIRED and must be absolute in production (the server
# exits on startup otherwise) — a relative path resolves inside the app directory on most PaaS
# and is silently wiped on every deploy instead of living on a persistent disk; see render.yaml.
DATABASE_PATH=./data/family-app.db
CHORES_DATABASE_URL=file:./data/chores.db

# CORS allowlist. In development, any http(s)://localhost|127.0.0.1:<port> origin is
# always allowed, so you usually don't need to set these locally.
# ALLOWED_ORIGINS: comma-separated list of extra origins to allow (e.g. a staging URL).
# PUBLIC_APP_ORIGIN: the production frontend origin (e.g. https://app.example.com).
# REQUIRED in production — the server exits on startup if neither is set there (localhost
# allowlisting is dev-only, so without one of these no browser origin would be allowed at all).
# ALLOWED_ORIGINS=https://staging.example.com
# PUBLIC_APP_ORIGIN=https://app.example.com

# Supabase (required — the server exits on startup if these are missing).
# Create your own project at https://supabase.com/dashboard and copy these from
# Settings > API. Do not reuse a Supabase project/key that anyone else has access to.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
# Only needed for server-side operations that bypass RLS. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Auth
# JWT_SECRET signs/verifies login tokens. REQUIRED in production (the server exits on startup
# if it's missing, too short, or looks like a placeholder/dev value there); falls back to an
# insecure dev-only default otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
# Remote MCP stays unavailable until reviewed migrations and owner configuration are complete.
# MANUAL_POINT_SCHEMA_READY=false
# MCP_ENABLED=false
# MCP_PUBLIC_URL=https://family-app-ksog.onrender.com/mcp
# Predefined PUBLIC OAuth client; no client secret or API key is generated.
# Copy the exact client ID and callback from the owner's plugin setup; do not guess them.
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_REDIRECT_URI=
# How long parent/family (admin) tokens stay valid. Defaults: 12h in production, 7d in dev.
# JWT_EXPIRES_IN=12h
# How long child tokens stay valid — kept long by default in every environment so kids don't
# have to re-login constantly; their accounts are low-privilege.
# JWT_CHILD_EXPIRES_IN=7d
# bcrypt work factor for password hashing (10-15). Defaults to 12.
# BCRYPT_COST=12
# Optional: pin the initial seeded parent passwords (only used the first time the DB is seeded).
# If unset, a strong random password is generated per parent and printed once to the server log.
# SEED_ROMMEL_PASSWORD=
# SEED_CELIANE_PASSWORD=

# Optional: enables AI-assisted chore-template import (image OCR always; freeform PDF/text as a
# fallback). Without this, image import is disabled and text/PDF import uses a local line-parser
# only. Uploaded content (including household member names) is sent to OpenAI's API when this is
# set — see docs/security-runbook.md "Privacy notes: uploads & AI parsing" before enabling.
# OPENAI_API_KEY=

# Optional Bitcoin allowance feature (backend/src/services/bitcoinWallet.ts). Leave unset unless
# you intend to use it. BITCOIN_MNEMONIC/BITCOIN_XPRV control a real signing wallet — on mainnet
# this is money, not just an API credential. Generate offline, store only in the Render dashboard
# Environment tab (never here, never in git), and read docs/security-runbook.md's "Bitcoin hot
# wallet" section — rotating this key requires sweeping funds first, it is not a simple swap.
# BITCOIN_NETWORK=testnet
# BITCOIN_MNEMONIC=
# BITCOIN_XPRV=
