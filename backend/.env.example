# Copy this file to backend/.env and fill in your own values for local development.
# backend/.env is gitignored — never commit real credentials.

PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/family-app.db
CHORES_DATABASE_URL=file:./data/chores.db

# CORS allowlist. In development, any http(s)://localhost|127.0.0.1:<port> origin is
# always allowed, so you usually don't need to set these locally.
# ALLOWED_ORIGINS: comma-separated list of extra origins to allow (e.g. a staging URL).
# PUBLIC_APP_ORIGIN: the production frontend origin (e.g. https://app.example.com).
# ALLOWED_ORIGINS=https://staging.example.com
# PUBLIC_APP_ORIGIN=https://app.example.com

# Supabase (required — the server exits on startup if these are missing).
# Create your own project at https://supabase.com/dashboard and copy these from
# Settings > API. Do not reuse a Supabase project/key that anyone else has access to.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
# Only needed for server-side operations that bypass RLS. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Auth
# JWT_SECRET signs/verifies login tokens. REQUIRED in production (the server exits on startup
# if it's missing there); falls back to an insecure dev-only default otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
# How long parent/family (admin) tokens stay valid. Defaults: 12h in production, 7d in dev.
# JWT_EXPIRES_IN=12h
# How long child tokens stay valid — kept long by default in every environment so kids don't
# have to re-login constantly; their accounts are low-privilege.
# JWT_CHILD_EXPIRES_IN=7d
# bcrypt work factor for password hashing (10-15). Defaults to 12.
# BCRYPT_COST=12
# Optional: pin the initial seeded parent passwords (only used the first time the DB is seeded).
# If unset, a strong random password is generated per parent and printed once to the server log.
# SEED_ROMMEL_PASSWORD=
# SEED_CELIANE_PASSWORD=
